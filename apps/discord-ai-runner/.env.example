# Copy to .env on your Ubuntu host (never commit)
DISCORD_BOT_TOKEN=
NVIDIA_API_KEY=
API_BASE=https://api.adlmetbot.adenmgb.com
# RUNNER_SECRET=   # or SETUP_SECRET — auth for /internal/mention-tools on the Worker
# Optional: override model (default nvidia/nemotron-3.5-lightning-30b-a3b)
# NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
# CHAT_PERSONA is ignored (always helpful default); remove legacy sassy from server .env
# Optional tuning
CONTEXT_MESSAGE_LIMIT=20
NVIDIA_MAX_TOKENS=400
EDIT_THROTTLE_MS=900
