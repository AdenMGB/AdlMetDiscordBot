{
	"name": "adlmetbot",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"cf:deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"register-commands": "node scripts/register-commands.mjs",
		"gateway-relay": "node scripts/discord-gateway-relay.mjs",
		"discord-ai-runner:dev": "pnpm --filter @metro-mate/discord-ai-runner dev",
		"discord-ai-runner:build": "pnpm --filter @metro-mate/discord-ai-runner build",
		"import-gtfs": "python3 scripts/import-rail-gtfs.py",
		"import-gtfs:local": "python3 scripts/import-rail-gtfs.py --apply-local",
		"test": "vitest",
		"cf-typegen": "wrangler types"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.3",
		"@cloudflare/workers-types": "^5.20261110.1",
		"@types/node": "^26.6.6",
		"typescript": "^5.5.2",
		"vitest": "~5.0.3",
		"wrangler": "^4.160.0"
	},
	"dependencies": {
		"@metro-mate/chat-core": "workspace:*",
		"discord-interactions": "^4.4.0",
		"gtfs-realtime-bindings": "^2.2.0",
		"ws": "^8.18.3"
	}
}